    <div class="resource-links">
      <a href="/papers/swag-bnn-satellite.pdf" class="btn" download>Download Report (PDF)</a>
    </div>
  </section>
</Layout>

<style>
  .back { display: inline-block; margin-bottom: 2rem; text-decoration: none; color: #555; font-size: 0.9rem; }
  .back:hover { color: #1a1a1a; }

  .blog { max-width: 720px; }

  .blog header { margin-bottom: 2.5rem; }
  .tag { font-size: 0.72rem; background: #f0f4ff; color: #3b5bdb; padding: 0.2rem 0.55rem; border-radius: 999px; display: inline-block; margin-bottom: 0.75rem; }
  .blog h1 { font-size: 1.8rem; line-height: 1.3; margin-bottom: 0.75rem; }
  .subtitle { color: #666; font-size: 0.95rem; line-height: 1.5; }
  .subtitle a { color: #3b5bdb; }

  .blog section { margin-bottom: 2.5rem; }
  .blog h2 { font-size: 1.2rem; margin-bottom: 0.75rem; color: #1a1a1a; }
  .blog p { font-size: 1rem; line-height: 1.75; color: #333; margin-bottom: 0.75rem; }
  .blog ul { padding-left: 1.4rem; margin-bottom: 0.75rem; }
  .blog li { font-size: 1rem; line-height: 1.7; color: #333; margin-bottom: 0.4rem; }
  .blog em { font-style: italic; }
  .blog strong { font-weight: 600; }

  code { font-family: 'Menlo', 'Monaco', monospace; font-size: 0.88em; background: #f5f5f5; padding: 0.1em 0.35em; border-radius: 4px; }

  figure {
    margin: 1.5rem 0;
    background: #f8f9fa;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
  }
  figure img {
    width: 100%;
    height: auto;
    display: block;
  }

  figcaption {
    padding: 0.6rem 1rem;
    font-size: 0.82rem;
    color: #666;
    line-height: 1.5;
    border-top: 1px solid #e5e7eb;
  }

  .resources {
    max-width: 720px;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid #e5e7eb;
  }
  .resources h2 { font-size: 1.1rem; margin-bottom: 1rem; color: #1a1a1a; }
  .resource-links { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn { display: inline-block; padding: 0.65rem 1.25rem; background: #3b5bdb; color: #fff; border-radius: 7px; text-decoration: none; font-size: 0.95rem; font-weight: 500; }
  .btn:hover { background: #2f4ac7; }
  .btn-outline { background: #fff; color: #3b5bdb; border: 1.5px solid #3b5bdb; }
  .btn-outline:hover { background: #f0f4ff; }
</style>
