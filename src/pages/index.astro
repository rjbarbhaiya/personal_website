---
import Layout from '../layouts/Layout.astro';
import { categories } from '../data/projects';

---

<Layout title="Riddhi Barbhaiya — Projects">
  <section class="hero">
    <h1>Hi, I'm Riddhi</h1>
    <p>Master's researcher working at the intersection of machine learning and biomedical applications.</p>
  </section>

  {categories.map((cat) => (
    <section class="category" id={cat.id}>
      <h2 class="category-title">{cat.name}</h2>
      <div class="grid">
        {cat.projects.map((p) => (
          <a href={`${import.meta.env.BASE_URL}projects/${p.slug}`} class="card">
            <span class="tag">{cat.tag}</span>
            <h3>{p.title}</h3>
            <p>{p.summary}</p>
            <span class="card-link">View project →</span>
          </a>
        ))}
      </div>
    </section>
  ))}
</Layout>

<style>
  .hero { margin-bottom: 3rem; }
  .hero h1 { font-size: 2rem; margin-bottom: 0.5rem; }
  .hero p { color: #555; font-size: 1.05rem; max-width: 600px; }

  .category { margin-bottom: 3rem; scroll-margin-top: 1.5rem; }
  .category-title { font-size: 1.1rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: #888; margin-bottom: 1rem; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.25rem; }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s;
  }
  .card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); }

  .tag { font-size: 0.72rem; background: #f0f4ff; color: #3b5bdb; padding: 0.2rem 0.55rem; border-radius: 999px; width: fit-content; }

  .card h3 { font-size: 1rem; font-weight: 600; }
  .card p { font-size: 0.875rem; color: #555; flex: 1; line-height: 1.5; }
  .card-link { font-size: 0.82rem; color: #3b5bdb; font-weight: 500; }
</style>
